rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /catalogWords/{wordId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/progress/{wordId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Legacy private vocabulary is readable and removable only for migration.
    // New lesson content must be written to catalogWords by an administrator.
    match /users/{userId}/words/{wordId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if false;
    }
  }
}
